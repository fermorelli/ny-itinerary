{
  "name": "ny-itinerary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "import-data": "node scripts/import-xlsx.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/verify-data.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "deploy": "npm run import-data && npm test && npm run build && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^7.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
